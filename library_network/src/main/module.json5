{
  "module": {
    "name": "library_network",
    "type": "har",
    "deviceTypes": [
      "default",
      "tablet",
      "2in1"
    ],
    // 编译产物设置为ts(默认产物为js文件)
    "metadata": [
      {
        "name": "UseTsHar",
        "value": "true"
      }
    ],
    "routerMap": "$profile:router_map",
    // TODO:申请权限
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "usedScene": {
          "when": "always"
        }
      }
    ]
  }
}
